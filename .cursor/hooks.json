{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./.claude/hooks/protect-core.mjs",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node ./.claude/hooks/protect-core.mjs",
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Shell",
        "failClosed": true
      }
    ]
  }
}
